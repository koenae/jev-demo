# --- TypeSafe (demo 1, 2 en 3) -----------------------------------------------
# Early-access key van https://typesafe.ai
TYPESAFE_API_KEY=ts_...
# Optioneel: vaste modelversie i.p.v. de alias jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-latest

# --- LLM voor de agent in demo 3 ----------------------------------------------
# Kies één provider: openai | anthropic | azure_openai
LLM_PROVIDER=openai
# Modelnaam (bij azure_openai: de deployment-naam)
LLM_MODEL=gpt-5-mini

# openai  (ook voor Microsoft Foundry: de "API Key" uit "Call <model> in code",
#          plus de project-endpoint met /openai/v1 als base-URL)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://<project>.services.ai.azure.com/openai/v1

# anthropic  (bv. LLM_MODEL=claude-sonnet-5)
# ANTHROPIC_API_KEY=sk-ant-...

# azure_openai
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Demo 4 (head-to-head LLM vs Jev) -------------------------------------------
# Prijzen van je LLM in USD per miljoen tokens, voor de kostenkolommen. Zonder deze
# waarden tonen demo 3/4/5 "n/a". Voor Azure OpenAI / Foundry:
#   uv run python scripts/llm_prices.py --model gpt-5-mini
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# Voor gpt-5-modellen: zet de redenering laag voor een eerlijke snelheidsvergelijking
# LLM_REASONING_EFFORT=minimal
# Demo 5: aantal LLM-samples per ticket (standaard 20)
# LLM_SAMPLES=20

# --- Demo 3 (agent gate) --------------------------------------------------------
# Hoeveel recente berichten de poortwachter meekrijgt; minder = goedkoper en sneller per check
# GATE_CONTEXT_MESSAGES=10
