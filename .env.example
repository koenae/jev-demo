# --- TypeSafe (all demos) --------------------------------------------------------
# API key from https://typesafe.ai
TYPESAFE_API_KEY=ts_...
# Optional: pin a model version instead of the alias jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-latest

# --- LLM (demos 3, 4 and 5) -------------------------------------------------------
# Pick one provider: openai | anthropic | azure_openai
LLM_PROVIDER=openai
# Model name (for azure_openai: the deployment name)
LLM_MODEL=gpt-5-mini

# openai  (also for Microsoft Foundry: the "API Key" from "Call <model> in code",
#          plus the project endpoint with /openai/v1 as base URL)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://<project>.services.ai.azure.com/openai/v1

# anthropic  (e.g. LLM_MODEL=claude-sonnet-5)
# ANTHROPIC_API_KEY=sk-ant-...

# azure_openai
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Cost columns (demos 3, 4 and 5) ----------------------------------------------
# Your LLM prices in USD per million tokens. Without them the cost columns show "n/a".
# For Azure OpenAI / Foundry:  uv run python scripts/llm_prices.py --model gpt-5-mini
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# For gpt-5 models: keep reasoning low for a fair speed comparison
# LLM_REASONING_EFFORT=minimal
# Demo 5: number of LLM samples per ticket (default 20)
# LLM_SAMPLES=20

# --- Demo 3 (agent gate) -------------------------------------------------------------
# How many recent messages the judge gets; fewer = cheaper and faster per check
# GATE_CONTEXT_MESSAGES=10
